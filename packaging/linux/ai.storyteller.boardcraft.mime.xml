<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/vnd.storytold.boardcraft+zip">
    <sub-class-of type="application/zip"/>
    <comment>BoardCraft storyboard</comment>
    <glob pattern="*.boardcraft"/>
  </mime-type>
  <mime-type type="text/x-fountain">
    <sub-class-of type="text/plain"/>
    <comment>Fountain screenplay</comment>
    <glob pattern="*.fountain"/>
  </mime-type>
</mime-info>
