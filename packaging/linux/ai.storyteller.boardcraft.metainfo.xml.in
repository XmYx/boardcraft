<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>ai.storyteller.boardcraft</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>BoardCraft</name>
  <summary>Storyboards and animatics</summary>
  <description>
    <p>BoardCraft is an open-source storyboarding and animatic app, one of the Crafting Apps.</p>
    <ul>
      <li>Board a Fountain screenplay into scenes and panels</li>
      <li>Sketch with a pressure-sensitive brush and layers</li>
      <li>Frame camera pans and zooms, time panels on a timeline, play the animatic</li>
      <li>Export an OpenTimelineIO timeline for FilmCraft</li>
    </ul>
  </description>
  <launchable type="desktop-id">ai.storyteller.boardcraft.desktop</launchable>
  <url type="homepage">https://github.com/storytold/boardcraft</url>
  <developer id="ai.storyteller">
    <name>ArtCraft Team</name>
  </developer>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
